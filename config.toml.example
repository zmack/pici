# pi-cli configuration file
# Default location: ~/.config/pici/config.toml
# Override with: --config <path>  or  PICI_CONFIG=<path>
#
# CLI flags always take precedence over values here.
# Boolean flags (disabled, verbose, …) are OR-ed: true in either place → true.
# List fields (files, list): CLI non-empty wins; hooks_files accumulates both.

[model]
# id       = "gpt-4o"               # --model
# provider = "openai"               # --provider
# base_url = "http://127.0.0.1:8080/v1"  # --base-url  (local server)
# api_key  = ""                     # --api-key  (prefer env vars instead)

# Providers extend or override the built-in catalog. New providers need both
# api and base_url. Keys are scoped to that provider and are never written to
# session files or reused for another provider.
#
# [providers.openai]
# api_key_env = "OPENAI_API_KEY"
# auth = "required"                 # required|optional|none|oauth
# headers = { X-Tenant = "engineering" }
#
# [providers.local]
# api = "openai-completions"
# base_url = "http://127.0.0.1:8080/v1"
# auth = "none"
# headers = { X-Route = "local" }
#
# [[providers.local.models]]
# id = "qwen3-coder"
# name = "Qwen 3 Coder (Local)"
# context_window = 131072
# max_tokens = 16384
# reasoning = true
# input_capabilities = ["text"]
# headers = { X-Model-Route = "coder" }
# thinking_level_map = { off = false, low = "low", medium = "medium", high = "high" }
#
# [providers.openai.model_overrides."gpt-4.1"]
# context_window = 200000

# MCP servers are spawned as persistent child processes and their tools
# appear alongside builtins, qualified as "<name>__<tool>" (sanitized to a
# provider-safe character set, e.g. "filesystem__read_file"). --no-tools
# suppresses them the same as builtins; --no-builtin-tools does NOT (that
# flag is specifically about builtins). The child inherits pici's own
# environment, with `env` overlaid on top -- it is not a way to get a
# scrubbed environment. `enabled = false` keeps a server's config block
# around without spawning it. A server whose handshake fails or times out
# is skipped with a warning; it does not stop pici from starting.
#
# [[mcp_servers]]
# name    = "filesystem"
# command = "npx"
# args    = ["-y", "@modelcontextprotocol/server-filesystem", "/home/me/project"]
# enabled = true
#
# [[mcp_servers]]
# name    = "internal-tools"
# command = "/opt/mcp/internal-server"
# args    = ["--stdio"]
# cwd     = "/opt/mcp"
# env     = { MCP_LOG_LEVEL = "warn" }
# call_timeout_ms = 30000
#
# A server with `url` instead of `command` uses the streamable-HTTP
# transport (http:// or https://; no credentials inside the URL, redirects
# are not followed). `bearer_token_env` NAMES an environment variable holding
# a bearer token -- the token itself never goes in this file, the tool
# catalog, transcripts or logs. `headers` is for non-secret headers only
# (Authorization/Cookie/... are rejected). A dead stdio child or an expired
# HTTP session is reconnected on the next tool call or session start (at
# most once per second), and a server's tools/list_changed notification
# re-lists its tools for sessions created afterwards. MCP tools stay
# unavailable to child sessions.
#
# [[mcp_servers]]
# name             = "remote"
# url              = "https://mcp.example.com/mcp"
# bearer_token_env = "REMOTE_MCP_TOKEN"
# headers          = { X-Tenant = "acme" }

[agent]
# system_prompt = "You are a helpful coding assistant."  # --system-prompt
# thinking      = "off"   # --thinking: off|minimal|low|medium|high|xhigh

[agents]
# Child agents are read-only by default. "core" permits workspace-confined
# edit/write when spawn_agent requests allow_write_tools=true.
# "all" additionally permits bash and requires sandbox.mode != "disabled".
# write_tools = "none"   # none | core | all

[subagents]
# How much subagent concurrency/nesting a session allows. All fields are
# optional and independently overridable; an absent field (or an absent
# [subagents] table entirely) keeps pici's built-in default, shown below.
# Raise these for workflows that fan out across many subagents at once
# (batch review, parallel test triage, broad research) -- the defaults are
# tuned for occasional single-helper delegation, not batch fan-out.
# max_active_executions = 4     # concurrent subagents running at once
# max_resident_tasks     = 8     # total subagents held in memory at once
# max_nesting_depth      = 2     # how many levels deep delegation can go
# max_direct_children    = 4     # children one task may spawn directly
# max_wait_seconds       = 60    # how long agents.wait() blocks per call
# deliver_completions    = false # opt in: hand each finished child's bounded,
#   attributed result to the parent as input (queued while the parent is
#   busy, run as a turn when the REPL is idle) instead of waiting for polling

[tools]
# dir        = "~/.config/pici/tools"  # --tools-dir  (Lua tool scripts)
# disabled   = false                   # --no-tools
# no_builtin = false                   # --no-builtin-tools
# list       = ["read", "bash", "apply_patch", "edit", "write", "grep", "find", "ls"]
# lua_eval   = false                   # --lua-eval  (opt-in; default off)
#   Lets the agent execute Lua mid-turn, in-process, via a `lua` tool call --
#   with access to session-lifecycle actions (compaction/model-switch/fork),
#   subagent spawning, and mailbox messaging. This is real, if control-plane-
#   only, power: no new filesystem/shell reach, but the model can fork the
#   session or switch its own model. Accepted limitation: the curated Lua
#   environment has no string.find/match/gmatch/gsub (Lua's pattern-matching
#   engine can be driven into unbounded-CPU backtracking that no time budget
#   can interrupt), so the tool cannot do regex-like text matching.

[addons]
# files = ["~/.config/pici/rewind.lua"]  # --hooks-file (repeatable, loads in order)
# dir   = "~/.config/pici/addons"        # --hooks-dir  (all .lua files in dir)
# Example costline addon (shows last cost in prompt):
# files = ["~/.config/pici/addons/costline.lua"]

[display]
# render  = "auto"   # --render: auto|markdown|raw
# verbose = false    # --verbose

[context]
# disabled = false   # --no-context-files  (skip AGENTS.md / CLAUDE.md discovery)

[input]
# vim_mode = false   # Normal/Insert modal composer editing: motions h j k l
# w b e 0 $, operators d/c. No CLI flag -- config.toml opt-in only. Escape
# enters Normal mode; i/a/A/I return to Insert.

[sandbox]
# mode = "auto"       # auto|required|disabled; disabled is an explicit
#                      # unsandboxed host-execution escape hatch
